# Supabase Credentials Configuration for Al-Farhain AMC Ambulans
# Dapatkan maklumat ini dari Supabase Dashboard -> Project Settings -> API
# Hanya gunakan anon/publishable key dalam aplikasi pelayar.
# Jangan masukkan service-role key, secret key atau kata laluan pangkalan data.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
