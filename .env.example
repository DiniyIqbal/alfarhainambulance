# Supabase Credentials Configuration for Al-Farhain AMC Ambulans
# Dapatkan maklumat ini dari Supabase Dashboard -> Project Settings -> API
# Hanya gunakan anon/publishable key dalam aplikasi pelayar.
# Jangan masukkan service-role key, secret key atau kata laluan pangkalan data.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Maps Platform Configuration
# Client-side / Browser key for Google Maps JavaScript API (restricted to HTTP referrers: localhost / Vercel domain)
VITE_GOOGLE_MAPS_API_KEY=YOUR_DEVELOPMENT_BROWSER_KEY

# Optional Map ID for Google Maps JavaScript API (AdvancedMarkerElement styling)
# Create in Google Cloud Console -> Map Management -> Create Map ID -> JavaScript -> Vector
VITE_GOOGLE_MAPS_MAP_ID=YOUR_MAP_ID_OPTIONAL

# Backend / Server key for Google Maps Routes API (Used by /api/maps/route serverless function)
GOOGLE_MAPS_SERVER_KEY=YOUR_BACKEND_ROUTES_KEY

