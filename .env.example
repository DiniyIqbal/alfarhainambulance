# Supabase Credentials Configuration for Al-Farhain AMC Ambulans
# Dapatkan maklumat ini dari Supabase Dashboard -> Project Settings -> API
# Hanya gunakan anon/publishable key dalam aplikasi pelayar.
# Jangan masukkan service-role key, secret key atau kata laluan pangkalan data.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Maps Platform Configuration
# Client-side / Browser key for Google Maps JavaScript API (restricted to HTTP referrers: localhost / Vercel domain)
VITE_GOOGLE_MAPS_API_KEY=YOUR_DEVELOPMENT_BROWSER_KEY

# Optional Map ID for Google Maps JavaScript API (AdvancedMarkerElement styling)
# Create in Google Cloud Console -> Map Management -> Create Map ID -> JavaScript -> Vector
VITE_GOOGLE_MAPS_MAP_ID=YOUR_MAP_ID_OPTIONAL

# Backend / Server key for Google Maps Routes API (Used by /api/maps/route serverless function)
GOOGLE_MAPS_SERVER_KEY=YOUR_BACKEND_ROUTES_KEY

# CHIP Payment Gateway (Server-Side Only - DO NOT prefix with VITE_)
CHIP_BRAND_ID=YOUR_CHIP_BRAND_ID
CHIP_SECRET_KEY=YOUR_CHIP_SECRET_KEY
CHIP_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_CHIP_PUBLIC_KEY\n-----END PUBLIC KEY-----"
CHIP_API_URL=https://gate.chip-in.asia/api/v1
# Optional: fixed webhook URL (defaults to <APP_BASE_URL>/api/payment/webhook)
CHIP_WEBHOOK_URL=

# -------------------------------------------------------------------------
# Server-only security settings (Vercel -> Settings -> Environment Variables)
# NEVER prefix these with VITE_ (that would ship them to every browser).
# -------------------------------------------------------------------------
# Required by /api/* for auth checks, payments and driver onboarding.
# Without it, deployed APIs refuse requests (fail closed).
SUPABASE_SERVICE_ROLE_KEY=
# Canonical public URL, used for payment redirects and invitation links
# (avoids trusting the Host header).
APP_BASE_URL=https://alfarhainambulance.vercel.app
# Extra origins allowed to call /api/* from a browser (comma separated).
# The deployment's own origin is always allowed.
ALLOWED_ORIGINS=

# -------------------------------------------------------------------------
# Demo mode (1-click demo logins, mock users). Always on in `npm run dev`.
# Leave false for production. Only set true on a demo deployment that points
# at a NON-production Supabase project.
# -------------------------------------------------------------------------
VITE_ENABLE_DEMO=false


